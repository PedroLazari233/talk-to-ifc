# Copy this file to ".env" and fill in YOUR model. No code changes needed.
#
# LLM_FORMAT:  "openai"    -> any OpenAI-compatible API (Ollama, OpenAI, DeepSeek, Groq, vLLM/RunPod...)
#              "anthropic" -> Claude API
# LLM_URL:     the full chat endpoint
# LLM_MODEL:   the model name as the provider expects it
# LLM_API_KEY: leave empty for local models (Ollama)

# --- Local Ollama (default) ---
LLM_FORMAT=openai
LLM_URL=http://localhost:11434/v1/chat/completions
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=

# How many times to retry a wrong answer (each retry tells the model what was wrong).
# 2 is a good default; a small model gains the most from it, a strong one rarely needs it.
LLM_RETRIES=2

# IFC file to open (node tests/download_models.js downloads the test models)
IFC_PATH=tests/models/Duplex.ifc

# Seconds to wait for ONE reply from the LLM before giving up with an error (default 300).
# Raise it for slow reasoning models.
# LLM_TIMEOUT_SECONDS=300
